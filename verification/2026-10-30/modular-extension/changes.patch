+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Modules &amp; scripts · BlockAds</title>
+  <link rel="stylesheet" href="log.css"><link rel="stylesheet" href="manager.css">
+</head>
+<body>
+<main class="page">
+  <header class="header">
+    <div class="brand"><img src="icons/icon48.png" width="40" height="40" alt=""><div><p class="eyebrow">BLOCKADS SHIELD</p><h1>Modules &amp; scripts</h1><p class="muted">Your blocker. Your page customizations.</p></div></div>
+    <nav class="actions" aria-label="BlockAds"><a class="button-link" href="lists.html">My lists</a><a class="button-link" href="log.html">Activity log</a><button id="refresh">Refresh status</button></nav>
+  </header>
+  <p id="status" class="notice" role="status" aria-live="polite">Loading your modules…</p>
+  <section class="modules" aria-label="Installed modules">
+    <article class="card module"><div class="module-heading"><h2>Ad blocking</h2><span id="blockerStatus" class="badge">Checking</span></div><p class="muted">Network filters, page hiding, YouTube filtering and the element picker.</p><div class="module-actions"><a href="popup.html" class="button-link">Protection settings</a><label class="toggle"><input id="blockingEnabled" type="checkbox" disabled> Enable ad blocking</label></div></article>
+    <article class="card module"><div class="module-heading"><h2>Userscripts</h2><span id="scriptsStatus" class="badge">Checking</span></div><p class="muted">Run your scripts on the sites you choose. Each module has its own switch.</p><div class="module-actions"><span id="scriptCount" class="muted">Local script library</span><label class="toggle"><input id="userscriptsEnabled" type="checkbox" disabled> Enable userscripts</label></div></article>
+  </section>
+  <section id="accessPanel" class="notice" hidden aria-label="Userscript browser access"><p id="accessHelp"></p><div class="actions"><button id="grantAccess">Allow userscript access</button><button id="extensionDetails">Open extension details</button></div></section>
+  <section class="workspace" aria-label="Userscript library and editor">
+    <aside class="card library"><div class="toolbar"><h2>Script library</h2><span id="libraryCount" class="muted">0 scripts</span></div><div class="actions"><button id="newScript" class="primary" disabled>New script</button><button id="importScript" disabled>Import .user.js</button><input type="file" id="scriptFile" accept=".user.js,.js,text/javascript,text/plain" hidden></div><label class="search-label" for="searchScripts">Find a script</label><input id="searchScripts" type="search" placeholder="Search names or sites" autocomplete="off"><ul id="scriptList" aria-label="Saved scripts"></ul><p id="emptyLibrary" class="muted empty">No scripts yet.<br>Create one or import a local .user.js file.</p></aside>
+    <section class="card editor" aria-labelledby="editorHeading"><div class="toolbar"><h2 id="editorHeading">New script</h2><span id="draftState" class="muted">Saved scripts start disabled</span></div>
+      <p class="muted">Review the code and site scope before enabling a script. Saving an edit pauses that script.</p>
+      <label class="source-label" for="scriptSource">Script source</label><textarea id="scriptSource" spellcheck="false" autocomplete="off" autocapitalize="off" aria-describedby="sourceHelp" disabled></textarea>
