{
  "manifest_version": 3,
  "name": "Module Engine",
  "version": "1.9.0",
  "minimum_chrome_version": "121",
  "description": "Modular local ad and tracker blocking, plus a userscript manager with explicit site scopes and independent controls.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "alarms",
    "scripting",
    "webRequest"
  ],
  "optional_permissions": ["userScripts", "clipboardWrite", "offscreen", "notifications", "downloads", "webRequestBlocking", "cookies"],
  "options_ui": { "page": "src/ui/manager/manager.html", "open_in_tab": true },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_title": "Module Engine",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/background.js",
    "scripts": ["src/shared/shared.js", "src/blocking/flags.js", "src/blocking/cosmetic.js", "src/blocking/network.js", "src/background/modules.js", "vendor/publicsuffix/suffixes.js", "src/userscripts/userscripts-matching.js", "src/userscripts/userscripts-page.js", "src/userscripts/userscripts-core.js", "src/userscripts/userscripts-network.js", "src/userscripts/userscripts-updates.js", "src/userscripts/userscripts-offscreen.js", "src/userscripts/userscripts-xhr.js", "src/userscripts/clipboard.js", "src/userscripts/userscripts-actions.js", "src/userscripts/userscripts-runtime.js", "src/shared/debug-protocol.js", "src/background/debug-runtime.js", "src/background/network-log.js", "src/background/background.js"]
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_ruleset",
        "enabled": false,
        "path": "rules/ads.json"
      },
      {
        "id": "trackers_ruleset",
        "enabled": false,
        "path": "rules/trackers.json"
      },
      {
        "id": "threats_ruleset",
        "enabled": false,
        "path": "rules/threats.json"
      },
      {
        "id": "community_ruleset",
        "enabled": false,
        "path": "rules/community.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared/shared.js", "src/blocking/cosmetic.js", "src/blocking/procedural.js", "src/blocking/overlays.js", "src/blocking/reddit.js", "src/blocking/prompts.js", "src/blocking/buttons.js", "src/blocking/youtube-fallback.js", "src/blocking/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "blockads-shield@local.extension",
      "strict_min_version": "128.0"
    }
  }
}
