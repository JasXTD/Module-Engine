{
  "manifest_version": 3,
  "name": "Module Engine",
  "version": "1.9.0",
  "minimum_chrome_version": "121",
  "description": "Modular local ad and tracker blocking, plus a userscript manager with explicit site scopes and independent controls.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "alarms",
    "scripting",
    "webRequest"
  ],
  "optional_permissions": ["userScripts", "clipboardWrite", "offscreen", "notifications", "downloads", "webRequestBlocking"],
  "options_ui": { "page": "manager.html", "open_in_tab": true },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Module Engine",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["shared.js", "flags.js", "cosmetic.js", "network.js", "modules.js", "userscripts-core.js", "userscripts-network.js", "userscripts-offscreen.js", "userscripts-xhr.js", "clipboard.js", "userscripts-actions.js", "userscripts-runtime.js", "background.js"]
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_ruleset",
        "enabled": false,
        "path": "rules/ads.json"
      },
      {
        "id": "trackers_ruleset",
        "enabled": false,
        "path": "rules/trackers.json"
      },
      {
        "id": "threats_ruleset",
        "enabled": false,
        "path": "rules/threats.json"
      },
      {
        "id": "community_ruleset",
        "enabled": false,
        "path": "rules/community.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["cosmetic.js", "procedural.js", "reddit.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "blockads-shield@local.extension",
      "strict_min_version": "128.0"
    }
  }
}
